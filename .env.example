GROQ_API_KEY=
# Primary Gemini API key (Google AI Studio) — used first for all tasks:
GEMINI_PRIMARY_API_KEY=
# Fallback / backup Gemini API key:
GEMINI_API_KEY=
# Optional: leave blank to use automatic task-specific model carousels:
# - Essays: openai/gpt-oss-120b -> openai/gpt-oss-20b -> gemini-3.6-flash
# - Phone & chat: qwen/qwen3.8-27b -> gemini-3.5-flash-lite
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GEMINI_MODEL=
APP_URL=https://ulpana-hebrew.vercel.app
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=Ulpinebot
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required: independently generated random secret, at least 32 bytes.
JWT_SECRET=
# Must match secret_token configured for the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL=
# Shared database-backed beta request limits (reset daily at UTC midnight).
AI_DAILY_GLOBAL_LIMIT=2000
AI_DAILY_USER_LIMIT=200
AI_DAILY_GUEST_LIMIT=30
AI_MINUTE_LIMIT=40
# Private recording storage: configure either R2 or S3, with public access disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 alternative
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
