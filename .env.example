GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: at most one extra Groq attempt; blank avoids model hopping.
GROQ_FALLBACK_MODEL=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=https://ulpana-hebrew.vercel.app
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=Ulpinebot
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required: independently generated random secret, at least 32 bytes.
JWT_SECRET=
# Must match secret_token configured for the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL=
# Shared database-backed beta request limits (reset daily at UTC midnight).
AI_DAILY_GLOBAL_LIMIT=2000
AI_DAILY_USER_LIMIT=200
AI_DAILY_GUEST_LIMIT=30
AI_MINUTE_LIMIT=40
# Private recording storage: configure either R2 or S3, with public access disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 alternative
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
